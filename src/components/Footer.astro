---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-[var(--color-border)] px-6 py-6">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-[var(--color-text-muted)]">
    <p>&copy; {year} Requirements Driven Development</p>
    <div class="flex gap-6">
      <a href={`${base}blog/`} class="hover:text-[var(--color-accent)] transition-colors">Blog</a>
      <a href="#" class="hover:text-[var(--color-accent)] transition-colors">Book a call</a>
    </div>
  </div>
</footer>
