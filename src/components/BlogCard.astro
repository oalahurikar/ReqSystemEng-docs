---
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags } = Astro.props;
const base = import.meta.env.BASE_URL;
const formattedDate = pubDate.toLocaleDateString('en-us', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="border border-[var(--color-border)] rounded-lg p-5 hover:border-[var(--color-accent)] transition-colors">
  <a href={`${base}blog/${slug}/`} class="block">
    <time class="text-xs text-[var(--color-text-muted)]">{formattedDate}</time>
    <h3 class="text-lg font-semibold text-[var(--color-text)] mt-1">{title}</h3>
    <p class="text-sm text-[var(--color-text-muted)] mt-2">{description}</p>
  </a>
  {tags && tags.length > 0 && (
    <div class="mt-3">
      <TagList tags={tags} />
    </div>
  )}
</article>
