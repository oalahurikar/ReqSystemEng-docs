---
import tagsData from '../data/tags.json';

interface Props {
  tags?: string[];
}

const { tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const tagMap = new Map(tagsData.map((t) => [t.slug, t]));
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2">
    {tags.map((slug) => {
      const tag = tagMap.get(slug);
      return tag ? (
        <li>
          <a
            href={`${base}blog/tags/${tag.slug}/`}
            class="inline-block text-xs font-medium px-2.5 py-1 rounded-full border border-[var(--color-accent)] text-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-[var(--color-bg)] transition-colors"
          >
            {tag.name}
          </a>
        </li>
      ) : null;
    })}
  </ul>
)}
