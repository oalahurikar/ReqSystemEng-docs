---
const base = import.meta.env.BASE_URL;
---

<header class="border-b border-[var(--color-border)] px-6 py-4">
  <nav class="max-w-5xl mx-auto flex items-center justify-between">
    <a href={base} class="text-lg font-semibold text-[var(--color-text)] hover:text-[var(--color-accent)]">
      RDD
    </a>
    <div class="flex items-center gap-6 text-sm">
      <a href={`${base}blog/`} class="text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">Blog</a>
      <a
        href="https://reqsystemeng-production.up.railway.app"
        class="px-4 py-2 bg-[var(--color-accent)] text-[var(--color-btn-text)] font-medium rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors text-sm"
      >
        Try a free session
      </a>
    </div>
  </nav>
</header>
