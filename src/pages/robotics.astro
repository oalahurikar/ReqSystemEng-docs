---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<BaseLayout
  title="RDD — Catch cross-domain integration failures before hardware respins"
  description="Talk through your robotics design with an AI that listens like an engineer. It captures interface contracts, flags cross-domain conflicts, and tracks dependencies between sensors, actuators, firmware, and software layers."
  ctaMode="waitlist"
>

  <!-- Hero -->
  <section class="max-w-3xl mx-auto px-6 pt-12 pb-6 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight">
      Your robot has 47 cross-domain dependencies.<br/>You're tracking zero of them.
    </h1>
    <p class="text-lg text-[var(--color-text-muted)] mt-4 max-w-xl mx-auto leading-relaxed">
      A co-pilot that captures interface contracts from engineering conversations — so you catch integration failures before hardware respins.
    </p>
  </section>

  <!-- The Problem -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6">
      <div class="space-y-3">
        <div class="rounded-lg border border-[var(--color-border)] p-4">
          <p class="text-sm text-[var(--color-text)] leading-relaxed">
            <span class="font-semibold">IMU says NED. Nav stack expects ENU.</span> Found out when the EKF diverged. Three days lost.
          </p>
        </div>
        <div class="rounded-lg border border-[var(--color-border)] p-4">
          <p class="text-sm text-[var(--color-text)] leading-relaxed">
            <span class="font-semibold">Swapped the LiDAR. SLAM broke.</span> Nobody tracked which perception params depended on the old spec.
          </p>
        </div>
        <div class="rounded-lg border border-[var(--color-border)] p-4">
          <p class="text-sm text-[var(--color-text)] leading-relaxed">
            <span class="font-semibold">Firmware update added a byte to the CAN message.</span> Driver parsed garbage. Robot arm went to wrong position.
          </p>
        </div>
      </div>
      <p class="text-[var(--color-text)] mt-4 leading-relaxed font-medium">
        These aren't bugs. They're invisible dependencies between layers that no tool tracks.
      </p>
    </div>
  </section>

  <!-- Waitlist Form -->
  <WaitlistForm />

  <!-- What Your Toolchain Doesn't Track -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tight mb-4">
        What your toolchain doesn't track.
      </h2>
      <p class="text-[var(--color-text-muted)] leading-relaxed">
        rosdep tracks package deps. Docker isolates environments. tf2 manages transforms.
      </p>
      <p class="text-[var(--color-text)] mt-3 leading-relaxed font-medium">
        None of them track: "Why is this parameter 0.8? Who decided? What breaks if it changes?"
      </p>
      <p class="text-[var(--color-text-muted)] mt-3 leading-relaxed">
        We track the decision graph — the interface contracts between your hardware and software layers.
      </p>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-6">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tight text-center mb-4">
        How it works.
      </h2>

      <div class="space-y-3">
        <div>
          <p class="text-sm font-semibold text-[var(--color-text-muted)] mb-1">Step 1</p>
          <h3 class="text-lg font-semibold mb-1">Talk about what you're building</h3>
          <p class="text-[var(--color-text-muted)]">
            Sensor stack, actuator integration, system architecture — describe it in plain language.
          </p>
        </div>

        <div>
          <p class="text-sm font-semibold text-[var(--color-text-muted)] mb-1">Step 2</p>
          <h3 class="text-lg font-semibold mb-1">The co-pilot captures what matters</h3>
          <p class="text-[var(--color-text-muted)]">
            Interface contracts, assumptions, and parameter decisions — captured into a dependency graph as you talk.
          </p>
        </div>

        <div>
          <p class="text-sm font-semibold text-[var(--color-text-muted)] mb-1">Step 3</p>
          <h3 class="text-lg font-semibold mb-1">Change something — see the blast radius</h3>
          <p class="text-[var(--color-text-muted)]">
            Swap a sensor, update firmware, change a parameter. Instantly see every decision and interface affected.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold tracking-tight mb-4">
        Stop finding integration failures at the bench.
      </h2>
      <a href="#waitlist" class="inline-block px-8 py-3 bg-[var(--color-accent)] text-[var(--color-btn-text)] font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors">
        Join the waitlist
      </a>
    </div>
  </section>

</BaseLayout>
