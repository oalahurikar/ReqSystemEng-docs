---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConvoBlock from '../components/ConvoBlock.astro';

const base = import.meta.env.BASE_URL;

const heroConvo = [
  { role: 'user' as const, text: 'I need a drone that can carry 5 kg within a 2-mile radius.' },
  { role: 'copilot' as const, text: "What's the payload, and what's the mission? Delivery, equipment mounting, or sensor packages — those drive fundamentally different designs." },
  { role: 'user' as const, text: 'Surveying agriculture fields. Thermal imaging.' },
  { role: 'copilot' as const, text: "Thermal cameras in this class typically weigh 150\u2013200g — your 5 kg spec may be 25x above what you need. And a 10-acre field is ~200m across, well within a fraction of your 2-mile range. Worth starting from the actual mission parameters?" },
];

const thermoConvo = [
  { role: 'user' as const, text: 'I want to create a touchless thermometer for children.' },
  { role: 'copilot' as const, text: "What problem are you trying to solve? Is this for home use, clinical settings, or something else? And what does success look like — parents checking fever at bedtime, or nurses triaging 50 kids/hour?" },
  { role: 'user' as const, text: 'Within \u00b10.5\u00b0F, toddler squirming but cooperating for 2\u20133 seconds.' },
  { role: 'copilot' as const, text: "Decision 1: Measurement Accuracy\n\u251c\u2500 Spec: \u00b10.5\u00b0F (\u00b10.28\u00b0C) across 95\u2013104\u00b0F range\n\u251c\u2500 Test: Calibrated reference vs device on water bath at 98.6\u00b0F, 100.4\u00b0F, 102\u00b0F\n\u2514\u2500 Status: Captured\n\nDecision 2: Measurement Time Window\n\u251c\u2500 Spec: Complete reading in \u22643 seconds from trigger\n\u251c\u2500 Test: Stopwatch from button press to displayed result, 20 trials\n\u2514\u2500 Conditional: Assumes forehead aim (not ear canal)" },
];

const propConvo = [
  { role: 'copilot' as const, text: "Frame arm length: ~125mm. Prop radius: 89mm. Clearance between adjacent props: 6mm.\n\n6mm is below the 15mm safety minimum. At flex and vibration \u2014 props will collide." },
];

const decisions = [
  { decision: 'Measurement accuracy', spec: '\u00b10.5\u00b0F (\u00b10.28\u00b0C) across 95\u2013104\u00b0F' },
  { decision: 'Measurement time', spec: 'Complete reading in \u22643 seconds' },
  { decision: 'Target mode', spec: 'Forehead (non-contact)' },
  { decision: 'Test protocol', spec: 'Calibrated reference at 98.6\u00b0F, 100.4\u00b0F, 102\u00b0F' },
];
---

<BaseLayout
  title="RDD — Talk through your design. Catch what you missed."
  description="Talk through your design with an AI that listens like an engineer. It captures your decisions, flags gaps at the boundaries, and tracks what you decided, why, and what depends on it."
>

  <!-- Hero -->
  <section class="max-w-3xl mx-auto px-6 pt-12 pb-6 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-tight">
      Talk through your design.<br/>Catch what you missed.
    </h1>
    <p class="text-lg text-[var(--color-text-muted)] mt-4 max-w-xl mx-auto leading-relaxed">
      Talk through your design with an AI that listens like an engineer. It captures your decisions, flags gaps at the boundaries, and tracks what you decided, why, and what depends on it.
    </p>
    <div class="mt-8">
      <a href="#pricing" class="inline-block px-8 py-3 bg-[var(--color-accent)] text-[var(--color-btn-text)] font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors text-lg">
        Try a free session
      </a>
    </div>
  </section>

  <!-- Demo conversation -->
  <section class="max-w-2xl mx-auto px-6 pb-6">
    <ConvoBlock messages={heroConvo} />
  </section>

  <!-- Problem -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tight">
        You know your components.<br/>You're missing the spaces between.
      </h2>
      <p class="text-[var(--color-text-muted)] mt-4 leading-relaxed">
        Engineers think one component at a time. Failures live in the connections — where the battery meets the motor, where the sensor talks to the MCU, where firmware assumes a voltage the hardware doesn't deliver.
      </p>
      <p class="text-[var(--color-text-muted)] mt-3 leading-relaxed">
        A typical cross-domain system has dozens of these boundaries. Engineers define 2–3 parameters at each one. The other 4–5 surface at integration — when fixing them costs $5K–$50K and 6 weeks.
      </p>
      <p class="text-[var(--color-text)] mt-3 leading-relaxed">
        The co-pilot catches those gaps while you're still talking.
      </p>
      <p class="text-sm text-[var(--color-text-muted)] mt-4 opacity-60">
        We're not a PLM. Not replacing your CAD or BOM tool. We're the thinking layer before all of that — where decisions get made and where the expensive mistakes happen.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-6">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tight text-center mb-6">
        Think out loud. Get structured output.
      </h2>

      <div class="space-y-8">
        <div>
          <p class="text-sm font-semibold text-[var(--color-text-muted)] mb-1">Step 1</p>
          <h3 class="text-lg font-semibold mb-1">Describe your project</h3>
          <p class="text-[var(--color-text-muted)]">
            Talk about what you're building in plain language. No forms, no modeling syntax, no "shall" statements.
          </p>
        </div>

        <div>
          <p class="text-sm font-semibold text-[var(--color-text-muted)] mb-1">Step 2</p>
          <h3 class="text-lg font-semibold mb-1">The co-pilot sharpens and captures</h3>
          <p class="text-[var(--color-text-muted)]">
            It asks the questions your design review would ask — but earlier, and without missing anything. Vague specs get sharpened. Premature decisions get challenged. Dependencies get tracked.
          </p>
        </div>

        <div>
          <p class="text-sm font-semibold text-[var(--color-text-muted)] mb-1">Step 3</p>
          <h3 class="text-lg font-semibold mb-1">Your decisions, structured</h3>
          <p class="text-[var(--color-text-muted)] mb-4">
            Every decision tracked with specs, rationale, and dependencies. Change one thing — see what else is affected.
          </p>

          <p class="text-sm text-[var(--color-text-muted)] mb-2">
            One sentence — "a touchless thermometer for children" — becomes testable decisions in four exchanges:
          </p>
          <div class="overflow-x-auto rounded-lg border border-[var(--color-border)]">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-[var(--color-surface)]">
                  <th class="text-left px-4 py-2.5 font-semibold text-[var(--color-text)]">Decision</th>
                  <th class="text-left px-4 py-2.5 font-semibold text-[var(--color-text)]">Spec</th>
                </tr>
              </thead>
              <tbody>
                {decisions.map((row) => (
                  <tr class="border-t border-[var(--color-border)]">
                    <td class="px-4 py-2 font-medium text-[var(--color-text)]">{row.decision}</td>
                    <td class="px-4 py-2 text-[var(--color-text-muted)]">{row.spec}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Real session output -->
      <div class="mt-8">
        <p class="text-sm text-[var(--color-text-muted)] mb-2">
          Real session, 3 minutes in. Engineer said 6 words. Co-pilot captured 2 testable decisions:
        </p>
        <ConvoBlock messages={thermoConvo} />
      </div>
    </div>
  </section>

  <!-- Caught before hardware -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tight mb-4">
        Caught before hardware.
      </h2>
      <p class="text-[var(--color-text-muted)] leading-relaxed">
        An engineer specified 7-inch propellers for hover efficiency on an agricultural drone. Another specified a 250mm folding frame to fit a Pelican case. Both choices correct in isolation.
      </p>

      <div class="mt-4">
        <ConvoBlock messages={propConvo} />
      </div>

      <p class="text-[var(--color-text-muted)] mt-4 leading-relaxed">
        Neither made a mistake. The conflict only exists at the intersection.
      </p>

      <div class="mt-4 rounded-lg border border-[var(--color-border)] overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-[var(--color-surface)]">
              <th class="text-left px-4 py-2.5 font-semibold text-[var(--color-text)]"></th>
              <th class="text-left px-4 py-2.5 font-semibold text-[var(--color-text)]">Without co-pilot</th>
              <th class="text-left px-4 py-2.5 font-semibold text-[var(--color-text)]">With co-pilot</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-[var(--color-border)]">
              <td class="px-4 py-2 font-medium text-[var(--color-text)]">When discovered</td>
              <td class="px-4 py-2 text-[var(--color-text-muted)]">Assembly (week 6)</td>
              <td class="px-4 py-2 text-[var(--color-text-muted)]">Conversation (minute 15)</td>
            </tr>
            <tr class="border-t border-[var(--color-border)]">
              <td class="px-4 py-2 font-medium text-[var(--color-text)]">Cost</td>
              <td class="px-4 py-2 text-[var(--color-text-muted)]">~$2K + 3 weeks</td>
              <td class="px-4 py-2 text-[var(--color-text-muted)]">$0 + 30 seconds</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Artifacts -->
  <section class="py-6">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tight text-center mb-2">
        Real engineering artifacts. Not chat logs.
      </h2>
      <p class="text-center text-[var(--color-text-muted)] mb-4">
        Generated from your conversation. Structured. Searchable. Ready for design reviews.
      </p>

      <div class="space-y-4">
        <div class="rounded-lg border border-[var(--color-border)] p-5">
          <h3 class="font-semibold text-[var(--color-text)] mb-1">Decision Document</h3>
          <p class="text-sm text-[var(--color-text-muted)]">
            Every decision with specs, rationale, rejected alternatives, and dependencies.
          </p>
        </div>
        <div class="rounded-lg border border-[var(--color-border)] p-5">
          <h3 class="font-semibold text-[var(--color-text)] mb-1">Interface Control Document</h3>
          <p class="text-sm text-[var(--color-text-muted)]">
            Every boundary where responsibility transfers — connectors, signals, data formats, thermal paths.
          </p>
        </div>
        <div class="rounded-lg border border-[var(--color-border)] p-5">
          <h3 class="font-semibold text-[var(--color-text)] mb-1">Dependency Map</h3>
          <p class="text-sm text-[var(--color-text-muted)]">
            What connects to what, and what breaks when something changes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Differentiator -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tight">
        This isn't ChatGPT with an engineering prompt.
      </h2>
      <p class="text-[var(--color-text-muted)] mt-4 leading-relaxed">
        ChatGPT can answer engineering questions. It can't track 30 decisions, flag when decision #27 contradicts decision #4, or catch that two engineers made independently valid choices that are physically incompatible.
      </p>
      <p class="text-[var(--color-text-muted)] mt-3 leading-relaxed">
        The co-pilot doesn't make decisions. You do. It asks questions, flags gaps, and surfaces conflicts. You verify and decide.
      </p>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold tracking-tight mb-4">
        If your system crosses domains, this is for you.
      </h2>
      <p class="text-[var(--color-text-muted)] leading-relaxed">
        Built for projects where mechanical, electrical, and software interact — drones, robots, medical devices, anything with 10+ components that talk to each other.
      </p>
    </div>
  </section>

  <!-- Social proof -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6 space-y-3">
      <div class="rounded-lg border border-[var(--color-border)] p-5">
        <p class="text-[var(--color-text)] leading-relaxed italic">
          "I had the props and frame specced on the same page and still missed it. The co-pilot caught that my 7-inch props left 6mm clearance on a 250mm frame — they'd clip in any crosswind. That's a $2K carbon fiber reorder I didn't have to make."
        </p>
        <p class="text-sm text-[var(--color-text-muted)] mt-3">
          — Drone engineer, agricultural survey project
        </p>
      </div>
      <div class="rounded-lg border border-[var(--color-border)] p-5">
        <p class="text-[var(--color-text)] leading-relaxed italic">
          "I said 10 pounds max and 12-hour runtime in the same breath. Seemed reasonable. The co-pilot did the math I hadn't — the battery alone could weigh 10 pounds. I would have gotten to prototyping before realizing the weight budget was broken."
        </p>
        <p class="text-sm text-[var(--color-text-muted)] mt-3">
          — Embedded systems engineer, roadside safety device
        </p>
      </div>
      <div class="rounded-lg border border-[var(--color-border)] p-5">
        <p class="text-[var(--color-text)] leading-relaxed italic">
          "I didn't realize the motor change affected the thermal budget until the co-pilot showed me. I would have found that at integration — three weeks and a board respin later."
        </p>
        <p class="text-sm text-[var(--color-text-muted)] mt-3">
          — Hardware engineer, validation session
        </p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-6">
    <div class="max-w-lg mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold tracking-tight mb-6">
        Try it on a real project.
      </h2>

      <div class="rounded-lg border border-[var(--color-border)] overflow-hidden mb-6">
        <div class="flex">
          <div class="flex-1 px-6 py-5 bg-[var(--color-surface)]">
            <p class="text-sm text-[var(--color-text-muted)]">First session</p>
            <p class="text-3xl font-bold text-[var(--color-text)] mt-1">Free</p>
          </div>
          <div class="flex-1 px-6 py-5 border-l border-[var(--color-border)]">
            <p class="text-sm text-[var(--color-text-muted)]">After that</p>
            <p class="text-3xl font-bold text-[var(--color-text)] mt-1">$29</p>
            <p class="text-xs text-[var(--color-text-muted)]">per month</p>
          </div>
        </div>
      </div>

      <p class="text-[var(--color-text-muted)] mb-2">
        One session. One project. $29 per month.
      </p>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="py-6">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold tracking-tight mb-4">
        Your next design review will wish you'd done this first.
      </h2>
      <a href="https://reqsystemeng-production.up.railway.app" class="inline-block px-8 py-3 bg-[var(--color-accent)] text-[var(--color-btn-text)] font-semibold rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors">
        Start a free session
      </a>
    </div>
  </section>

</BaseLayout>
