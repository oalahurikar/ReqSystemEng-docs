---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="RDD — Requirements Driven Development">
  <section class="max-w-3xl mx-auto px-6 py-24 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">
      Requirements Driven Development
    </h1>
    <p class="text-lg text-[var(--color-text-muted)] mt-6 max-w-2xl mx-auto">
      Ship safe machines without administrative paralysis. Requirements that stay alive, connected, and meaningful — without manual babysitting.
    </p>
    <div class="flex gap-4 justify-center mt-10">
      <a
        href={`${base}blog/`}
        class="px-6 py-3 bg-[var(--color-accent)] text-[var(--color-bg)] font-medium rounded-lg hover:bg-[var(--color-accent-hover)] transition-colors"
      >
        Read the Blog
      </a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 pb-24">
    <div class="grid sm:grid-cols-3 gap-6">
      <div class="border border-[var(--color-border)] rounded-lg p-6">
        <h3 class="font-semibold text-[var(--color-accent)]">Active, Not Passive</h3>
        <p class="text-sm text-[var(--color-text-muted)] mt-2">
          Block bad operations at the gate. No more red flags nobody clicks.
        </p>
      </div>
      <div class="border border-[var(--color-border)] rounded-lg p-6">
        <h3 class="font-semibold text-[var(--color-accent)]">Graph-Native</h3>
        <p class="text-sm text-[var(--color-text-muted)] mt-2">
          Everything is nodes and edges. Relationships are first-class citizens.
        </p>
      </div>
      <div class="border border-[var(--color-border)] rounded-lg p-6">
        <h3 class="font-semibold text-[var(--color-accent)]">Interview First</h3>
        <p class="text-sm text-[var(--color-text-muted)] mt-2">
          Guide users through questions before accepting answers. Conversation feel, structured output.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
